# BhoomiVaani Environment Configuration
# Copy this file to .env and configure your values

# Speech provider credentials. Keep this key on the backend only.
# Obtain from https://app.gnani.ai/voice
GNANI_API_KEY=
PRISMA_API_URL=https://api.vachana.ai/stt/v3
TIMBRE_API_URL=https://api.vachana.ai/api/v1/tts/inference

# Google Flow avatar source (served read-only for Bhoomi's one-time introduction).
BHOOMI_INTRO_VIDEO_PATH=C:\Users\Gowthami\bhoomivaani\AI_assistant_speaking_to_camera_176b211d.mp4

# Optional private MuseTalk-compatible GPU adapter. Its POST contract is documented in docs/avatar-lipsync.md.
LIPSYNC_API_URL=
LIPSYNC_API_KEY=
FFMPEG_PATH=ffmpeg
# Stored outside the repository under the current user's local application-data directory by default.
BHOOMI_VOICE_EMBEDDING_PATH=

# Application Settings
MOCK_MODE=false
REASONING_PROVIDER=
REASONING_API_KEY=
REASONING_API_BASE_URL=
REASONING_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
PRISMA_REQUEST_TIMEOUT_SECONDS=120
DEFAULT_CONVERSATION_LANGUAGE=te
DEFAULT_INTERFACE_LANGUAGE=en
DEFAULT_LANGUAGE=te
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10

# Land data sources (external adapters are intentionally not implemented yet).
# Keep provider selections and credentials independent; blank provider means unavailable.
LAND_LISTING_PROVIDER=USER_SUBMITTED
LAND_LISTING_API_KEY=
LAND_RECORD_PROVIDER=
LAND_RECORD_API_KEY=
LAND_GEOCODING_PROVIDER=
LAND_GEOCODING_API_KEY=
LAND_NEARBY_PLACES_PROVIDER=
LAND_NEARBY_PLACES_API_KEY=
LAND_USE_PROVIDER=
LAND_USE_API_KEY=
USER_SUBMITTED_LISTINGS_ENABLED=true
USER_SUBMITTED_LANDS_FILE=
