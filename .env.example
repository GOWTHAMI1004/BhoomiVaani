# BhoomiVaani Environment Configuration
# Copy this file to .env and configure your values

# Gnani AI API Credentials
# Sign up at https://api.vachana.ai to obtain your API key
GNANI_API_KEY=
PRISMA_API_URL=https://api.vachana.ai/stt/v3
EVON_API_URL=https://api.vachana.ai/v1/chat/completions
TIMBRE_API_URL=https://api.vachana.ai/api/v1/tts/inference

# Application Settings
MOCK_MODE=true
DEFAULT_LANGUAGE=te
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10
